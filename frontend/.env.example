# Only public URLs go in this file, never keys, tokens or secrets.
# NEXT_PUBLIC_* values are bundled into client JavaScript.
# Base URL of the future agent backend. Leave empty to run replay-only (live runs show as offline).
NEXT_PUBLIC_AGENT_URL=
# Public URL of this site, used for metadataBase and the OG image.
NEXT_PUBLIC_SITE_URL=

# Supabase project (sign-in). The publishable key is public by design, safe here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
