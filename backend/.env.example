# Verity agent env template. Copy to backend/.env (gitignored) and fill in LLM_API_KEY.
# This file holds names and public defaults only. Never put a real key in it.

VERITY_ENV=development
# fake = $0 canned responses; nebius = real Nemotron calls (spends credits)
VERITY_PROVIDER=nebius
VERITY_TOOL_BACKEND=local_docker

# Nebius Token Factory (OpenAI compatible)
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
LLM_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
LLM_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b

# Nebius Sandboxes (only when VERITY_TOOL_BACKEND=nebius_sandbox; key falls back to LLM_API_KEY)
SANDBOX_BASE_URL=
SANDBOX_API_KEY=

# Web origins allowed to call the API (comma separated; never * in production)
VERITY_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth is off by default. Production requires auth on, access codes and a signing secret.
VERITY_AUTH__REQUIRED=false
# role:sha256hex,role:sha256hex (sha256 of each access code)
VERITY_ACCESS_CODE_HASHES=
# 32 or more random characters
VERITY_SIGNING_SECRET=

# Supabase project (accounts and saved chats). Paste backend/supabase/schema.sql into the
# project's SQL Editor once. SUPABASE_SECRET_KEY is the service_role / secret key, server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Docker Desktop on Windows: if /work is unwritable, uncomment to drop --user
# VERITY_TOOLS__DOCKER_USER=
