#!/usr/bin/env python3
"""/verity/bin/seeds: the winner's locked tests on more random seeds, plus lint warnings by tag (sign-off).

Contract: backend/CONTRACTS.md section 3.9 (stdout is one JSON object, schema verity.seeds/1). Input: the winner at
$VERITY_WORK_DIR/dut.v, the pack at $VERITY_PACK_DIR, and $VERITY_SEEDS (comma separated integers). The pack files are
never changed: the seed reaches the testbench through VERITY_SEED and COCOTB_RANDOM_SEED, exactly as verify passes the
task.toml [sim] seed. Lint runs once (same Verilator command as verify), the design compiles once, then each seed is
one vvp run, two at a time.
"""

from __future__ import annotations

import os
import sys
import time
import traceback
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from typing import Any

LIB_DIR = Path(__file__).resolve().parent.parent / "lib"
sys.path.insert(0, str(LIB_DIR))
import verity_common as vc  # noqa: E402
import verity_sim as vs  # noqa: E402

MAX_SEEDS = 16
WORKERS = 2
MAX_FAILURES = 1  # first failing case per seed is enough for sign-off


def parse_seeds(text: str) -> list[int]:
    seeds: list[int] = []
    for part in text.split(","):
        part = part.strip()
        if not part:
            continue
        try:
            value = int(part)
        except ValueError as exc:
            raise vc.InputError(f"VERITY_SEEDS: not an integer: {part!r}") from exc
        if value < 0 or value > 2**31 - 1:
            raise vc.InputError(f"VERITY_SEEDS: out of range: {value}")
        if value not in seeds:
            seeds.append(value)
    if not seeds or len(seeds) > MAX_SEEDS:
        raise vc.InputError(f"VERITY_SEEDS: give 1 to {MAX_SEEDS} seeds")
    return seeds


def one_seed(task: dict[str, Any], vvp: Path, seed: int) -> dict[str, Any]:
    run_dir = vc.scratch_dir() / f"seed_{seed}"
    run = vs.run_tests(task, vvp, run_dir, seed=seed, timeout_s=vc.env_float("VERITY_SIM_TIMEOUT_S", 60))
    data = run.data or {}
    failures = [
        {
            "name": str(f.get("name", "")),
            "inputs": str(f.get("inputs", "")),
            "expected": str(f.get("expected", "")),
            "got": str(f.get("got", "")),
            "pass": False,
            "cycle": f.get("cycle"),
        }
        for f in data.get("failures", [])[:MAX_FAILURES]
    ]
    message = ""
    if run.timed_out:
        message = "simulation timed out"
    elif run.data is None:
        message = vc.first_line_matching(run.log, r"error|traceback|exception", "simulation produced no result")
    total = int(data.get("total", 0))
    passed = int(data.get("passed", 0))
    return {
        "seed": seed,
        "ok": vs.full_pass(task, run.data),
        "total": total,
        "passed": passed,
        "failure_count": int(data.get("failure_count", total - passed)),
        "failures": failures,
        "timed_out": run.timed_out,
        "message": message,
    }


def run_stages(task: dict[str, Any], dut: Path, seeds: list[int], result: dict[str, Any]) -> str:
    versions = vc.tool_versions(("verilator", "iverilog", "cocotb"))
    result["tool_versions"] = versions
    lint, problem = vs.run_lint(task["top"], dut, versions)
    if problem == "timeout":
        result["message"] = "lint timed out"
        return "timeout"
    result["lint"] = lint
    if lint is None or not lint["ok"]:
        result["message"] = "lint failed"
        return "lint_fail"

    vvp, text = vs.compile_design(
        task["top"], [dut], vc.scratch_dir() / "seeds_build", timeout_s=vc.env_float("VERITY_SIM_TIMEOUT_S", 60)
    )
    if vvp is None:
        result["message"] = vc.first_line_matching(text, r"error", "iverilog failed to compile the design")
        return "sim_error"

    with ThreadPoolExecutor(max_workers=WORKERS) as pool:
        runs = list(pool.map(lambda s: one_seed(task, vvp, s), seeds))
    result["seeds"] = runs
    if all(r["ok"] for r in runs):
        return "pass"
    if all(r["timed_out"] for r in runs):
        return "timeout"
    return "sim_fail"


def main() -> None:
    started = time.monotonic()
    result: dict[str, Any] = {
        "schema": "verity.seeds/1",
        "status": "internal_error",
        "lint": None,
        "seeds": [],
        "duration_ms": 0,
        "message": "",
        "tool_versions": {},
    }
    code = vc.EXIT_OK
    try:
        task = vc.load_task()
        dut = vc.require_file(vc.work_dir() / "dut.v")
        seeds = parse_seeds(os.environ.get("VERITY_SEEDS", ""))
        result["status"] = run_stages(task, dut, seeds, result)
    except vc.InputError as exc:
        result.update(status="input_error", message=str(exc))
        code = vc.EXIT_INPUT
    except Exception as exc:  # noqa: BLE001  (tool missing or crash: reported as internal_error, exit 3)
        traceback.print_exc(file=sys.stderr)
        result.update(status="internal_error", message=f"{type(exc).__name__}: {exc}"[:300])
        code = vc.EXIT_INTERNAL
    result["duration_ms"] = int((time.monotonic() - started) * 1000)
    vc.emit(result, code)


if __name__ == "__main__":
    main()
