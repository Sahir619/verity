#!/usr/bin/env python3
"""/verity/bin/wave: one extra simulation that dumps a waveform of one test case, cut to a window around its first
mismatch (or the start of the case when it passes).

Contract: backend/CONTRACTS.md section 3.11 (stdout is one JSON object, schema verity.wave/1). Input: the design at
$VERITY_WORK_DIR/dut.v, the pack at $VERITY_PACK_DIR, $VERITY_WAVE_CASE (a case name; empty means the first case).
The VCD is written by a dump module that Verity writes here (a second top level, the documented cocotb recipe for
Icarus), never by the design: $dumpfile and $dumpvars stay banned in model RTL. The pack is not changed: the shared
harness verity_tb.py runs the cases in wave mode, and the expected values come from the pack's golden.py (see
verity_wave.py).
"""

from __future__ import annotations

import importlib
import json
import os
import sys
import time
import traceback
from pathlib import Path
from typing import Any

LIB_DIR = Path(__file__).resolve().parent.parent / "lib"
sys.path.insert(0, str(LIB_DIR))
import verity_common as vc  # noqa: E402
import verity_sim as vs  # noqa: E402
import verity_wave as vw  # noqa: E402

DUMP_TOP = "verity_wave_dump"


def dump_module(top: str, vcd: Path) -> str:
    return f'module {DUMP_TOP}();\ninitial begin\n  $dumpfile("{vcd}");\n  $dumpvars(1, {top});\nend\nendmodule\n'


def load_golden() -> Any:
    """The pack's golden model (read-only /pack is already on sys.path for the testbench; add it here too)."""
    sys.path.insert(0, str(vc.pack_dir()))
    try:
        return importlib.import_module("golden")
    except Exception:  # noqa: BLE001  (no replay without it; the wave itself still works)
        traceback.print_exc(file=sys.stderr)
        return None


def run_stages(task: dict[str, Any], dut: Path, result: dict[str, Any]) -> str:
    top = task["top"]
    scratch = vc.fresh_dir(vc.scratch_dir() / "wave")
    vcd_path = scratch / "wave.vcd"
    trace_path = scratch / "trace.json"
    dump_file = scratch / "verity_wave_dump.v"
    dump_file.write_text(dump_module(top, vcd_path), encoding="ascii")
    timeout = vc.env_float("VERITY_SIM_TIMEOUT_S", 60)

    vvp, text = vs.compile_design(top, [dut, dump_file], scratch / "build", timeout_s=timeout, extra_tops=(DUMP_TOP,))
    if vvp is None:
        result["message"] = vc.first_line_matching(text, r"error", "iverilog failed to compile the design")
        return "compile_error"

    clock = str(task.get("clock", {}).get("name", ""))
    run = vs.run_tests(
        task,
        vvp,
        scratch / "run",
        seed=int(task.get("sim", {}).get("seed", 1)),
        timeout_s=timeout,
        extra_env={
            "VERITY_WAVE_TRACE": str(trace_path),
            "VERITY_WAVE_CASE": os.environ.get("VERITY_WAVE_CASE", ""),
            "VERITY_WAVE_CLOCK": clock,
            "VERITY_WAVE_AFTER": str(int(vc.env_float("VERITY_WAVE_AFTER", 4))),
        },
    )
    if run.timed_out:
        result["message"] = "simulation timed out"
        return "timeout"
    if not trace_path.is_file() or not vcd_path.is_file():
        result["message"] = vc.first_line_matching(run.log, r"error|traceback|exception", "the simulation wrote no waveform")
        return "sim_error"
    trace = json.loads(trace_path.read_text(encoding="utf-8"))
    if not trace.get("found"):
        result["message"] = f"case {trace.get('target')!r} is not in this testbench"
        return "no_case"

    vcd = vw.parse_vcd(vcd_path.read_text(encoding="ascii", errors="replace"), top)
    wave = vw.build_wave(
        vcd,
        task,
        trace,
        load_golden(),
        before=int(vc.env_float("VERITY_WAVE_BEFORE", 4)),
        after=int(vc.env_float("VERITY_WAVE_AFTER", 4)),
    )
    if wave is None:
        result["message"] = "no samples in the window"
        return "sim_error"
    result["wave"] = wave
    return "ok"


def main() -> None:
    started = time.monotonic()
    result: dict[str, Any] = {
        "schema": "verity.wave/1",
        "status": "internal_error",
        "wave": None,
        "duration_ms": 0,
        "message": "",
        "tool_versions": {},
    }
    code = vc.EXIT_OK
    try:
        task = vc.load_task()
        dut = vc.require_file(vc.work_dir() / "dut.v")
        result["tool_versions"] = vc.tool_versions(("iverilog", "cocotb"))
        result["status"] = run_stages(task, dut, result)
    except vc.InputError as exc:
        result.update(status="input_error", message=str(exc))
        code = vc.EXIT_INPUT
    except Exception as exc:  # noqa: BLE001  (tool missing or crash: reported as internal_error, exit 3)
        traceback.print_exc(file=sys.stderr)
        result.update(status="internal_error", message=f"{type(exc).__name__}: {exc}"[:300])
        code = vc.EXIT_INTERNAL
    result["duration_ms"] = int((time.monotonic() - started) * 1000)
    vc.emit(result, code)


if __name__ == "__main__":
    main()
