#!/usr/bin/env python3
"""/verity/bin/strength: run the locked tests on planted bugs (mutants of the winner) to measure test strength.

Contract: backend/CONTRACTS.md section 3.10 (stdout is one JSON object, schema verity.strength/1). Input:
$VERITY_WORK_DIR/mutants.json = {"mutants": [{"id": "m01", "text": "<whole Verilog file>"}, ...]}. The backend plants
the mutants with fixed rules (no model) and checks each against the RTL rules before it sends them. Each mutant is
compiled and simulated with the pack's own seed, two at a time:
  caught    the locked tests fail on it (a failing case, a crash or a timeout: the design would be rejected),
  survived  every locked test passes on it,
  invalid   it does not compile (not a planted bug: excluded from the count),
  not_run   the time budget ($VERITY_STRENGTH_BUDGET_S) ran out before it started.
"""

from __future__ import annotations

import json
import re
import sys
import threading
import time
import traceback
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from typing import Any

LIB_DIR = Path(__file__).resolve().parent.parent / "lib"
sys.path.insert(0, str(LIB_DIR))
import verity_common as vc  # noqa: E402
import verity_sim as vs  # noqa: E402

MAX_MUTANTS = 40
MAX_TEXT_BYTES = 64_000  # one mutated file is at most 20 KB (verity.core.rtl), but a core's mutant also carries the locked blocks.v
WORKERS = 2
_ID = re.compile(r"^[A-Za-z0-9_]{1,16}$")


def load_mutants() -> list[dict[str, str]]:
    path = vc.require_file(vc.work_dir() / "mutants.json")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise vc.InputError(f"mutants.json is not valid JSON: {exc}") from exc
    items = data.get("mutants") if isinstance(data, dict) else None
    if not isinstance(items, list) or not items or len(items) > MAX_MUTANTS:
        raise vc.InputError(f"mutants.json: give 1 to {MAX_MUTANTS} mutants")
    out: list[dict[str, str]] = []
    for item in items:
        mid = str(item.get("id", "")) if isinstance(item, dict) else ""
        text = item.get("text") if isinstance(item, dict) else None
        if not _ID.match(mid) or not isinstance(text, str) or len(text.encode("utf-8")) > MAX_TEXT_BYTES:
            raise vc.InputError(f"mutants.json: bad mutant entry {mid!r}")
        out.append({"id": mid, "text": text})
    return out


def run_all(task: dict[str, Any], mutants: list[dict[str, str]]) -> list[dict[str, Any]]:
    budget = vc.env_float("VERITY_STRENGTH_BUDGET_S", 150)
    per_mutant = vc.env_float("VERITY_MUTANT_TIMEOUT_S", 30)
    deadline = time.monotonic() + budget
    seed = int(task.get("sim", {}).get("seed", 1))
    lock = threading.Lock()

    def one(mutant: dict[str, str]) -> dict[str, Any]:
        started = time.monotonic()
        row: dict[str, Any] = {"id": mutant["id"], "status": "not_run", "detail": "", "passed": 0, "total": 0, "duration_ms": 0}
        left = deadline - started
        if left < 2:
            row["detail"] = "time budget used up"
            return row
        work = vc.fresh_dir(vc.scratch_dir() / "strength" / mutant["id"])
        dut = work / "dut.v"
        dut.write_text(mutant["text"], encoding="utf-8")
        vvp, text = vs.compile_design(task["top"], [dut], work / "build", timeout_s=min(per_mutant, left))
        if vvp is None:
            row.update(status="invalid", detail=vc.first_line_matching(text, r"error", "does not compile")[:200])
        else:
            run = vs.run_tests(task, vvp, work / "run", seed=seed, timeout_s=min(per_mutant, max(1.0, deadline - time.monotonic())))
            data = run.data or {}
            row["total"] = int(data.get("total", 0))
            row["passed"] = int(data.get("passed", 0))
            if vs.full_pass(task, run.data):
                row["status"] = "survived"
            else:
                row["status"] = "caught"
                if run.timed_out:
                    row["detail"] = "simulation timed out"
                elif run.data is None:
                    row["detail"] = "simulation did not finish"
                else:
                    first = (data.get("failures") or [{}])[0]
                    row["detail"] = str(first.get("name", ""))[:80]
        row["duration_ms"] = int((time.monotonic() - started) * 1000)
        with lock:
            vc.log(f"mutant {mutant['id']}: {row['status']} {row['detail']}")
        return row

    with ThreadPoolExecutor(max_workers=WORKERS) as pool:
        return list(pool.map(one, mutants))


def main() -> None:
    started = time.monotonic()
    result: dict[str, Any] = {
        "schema": "verity.strength/1",
        "status": "internal_error",
        "mutants": [],
        "duration_ms": 0,
        "message": "",
        "tool_versions": {},
    }
    code = vc.EXIT_OK
    try:
        task = vc.load_task()
        mutants = load_mutants()
        result["tool_versions"] = vc.tool_versions(("iverilog", "cocotb"))
        result["mutants"] = run_all(task, mutants)
        result["status"] = "ok"
    except vc.InputError as exc:
        result.update(status="input_error", message=str(exc))
        code = vc.EXIT_INPUT
    except Exception as exc:  # noqa: BLE001  (tool missing or crash: reported as internal_error, exit 3)
        traceback.print_exc(file=sys.stderr)
        result.update(status="internal_error", message=f"{type(exc).__name__}: {exc}"[:300])
        code = vc.EXIT_INTERNAL
    result["duration_ms"] = int((time.monotonic() - started) * 1000)
    vc.emit(result, code)


if __name__ == "__main__":
    main()
