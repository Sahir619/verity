#!/usr/bin/env python3
"""Compile one core with Verilator, run the image's locked Embench suite."""

import hashlib
import json
import os
import time
from pathlib import Path

import verity_common as vc


def main():
    started = time.monotonic()
    deadline = started + vc.env_float("VERITY_BENCH_TIMEOUT_S", 300)
    dut = vc.require_file(vc.work_dir() / "dut.v")
    task = vc.load_task()
    top = task["top"]
    if top not in ("rv32i_core", "rv32i_cache_core", "rv32i_pipe2_core"):
        raise vc.InputError("bench requires an RV32I core with contract 10.1 or 11.1 ports")
    try:
        wait_cycles = int(os.environ.get("VERITY_BENCH_WAIT", "0"))
        if wait_cycles < 0:
            raise ValueError
    except ValueError:
        raise vc.InputError("VERITY_BENCH_WAIT must be a nonnegative integer") from None
    os.environ["VERITY_BENCH_WAIT"] = str(wait_cycles)
    if top == "rv32i_pipe2_core" and wait_cycles:
        vc.emit({"schema": "verity.bench/1", "status": "not_supported", "wait_cycles": wait_cycles,
                 "bench": [], "message": "the pipelined core requires always-ready memory"})
        return
    harness = "bench_pipe2_main.cpp" if top == "rv32i_pipe2_core" else "bench_main.cpp"
    prefix = "Vrv32i_pipe2_core" if top == "rv32i_pipe2_core" else "Vrv32i_core"
    images = Path("/verity/bench")
    suite = json.loads((images / "suite.json").read_text())
    rows = suite["benchmarks"]
    selection = os.environ.get("VERITY_BENCH_NAMES", "")
    if selection:
        names = selection.split(",")
        if len(set(names)) != len(names) or not set(names) <= {row["name"] for row in rows}:
            raise vc.InputError("unknown or duplicate benchmark name")
        rows = [row for row in rows if row["name"] in names]
    build = vc.fresh_dir(vc.scratch_dir() / "bench")
    result = {"schema": "verity.bench/1", "status": "pass", "wait_cycles": wait_cycles,
              "bench": [], "expected": [row["name"] for row in rows]}
    proc = vc.run([
        "verilator", "--cc", "--exe", "--build", "-j", "2", "-Wno-fatal",
        "--top-module", top, "--prefix", prefix, "--Mdir", str(build), "-CFLAGS", "-O3",
        str(dut), f"/verity/lib/{harness}",
    ], timeout_s=min(90, max(1, deadline - time.monotonic())))
    if proc.rc:
        result.update(status="timeout" if proc.timed_out else "compile_error", message=vc.tail(proc.output, 4000))
    else:
        for row in rows:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                result.update(status="timeout", message="benchmark suite deadline exceeded")
                break
            image = images / row["image"]
            if hashlib.sha256(image.read_bytes()).hexdigest() != row["sha256"]:
                raise RuntimeError(f"benchmark image integrity failure: {row['name']}")
            run = vc.run([str(build / prefix), str(image), "1000000000"], timeout_s=remaining)
            if run.timed_out:
                result.update(status="timeout", message=f"{row['name']}: simulation deadline exceeded")
                break
            try:
                if run.rc:
                    raise ValueError(f"simulator exited {run.rc}")
                data = json.loads(run.output.strip().splitlines()[-1])
            except (ValueError, IndexError) as exc:
                result.update(status="sim_error", message=f"{row['name']}: {exc}; {vc.tail(run.output, 1000)}")
                break
            data["name"] = row["name"]
            data["cpi"] = data["cycles"] / data["instructions"] if data["instructions"] else None
            result["bench"].append(data)
            if not data["passed"]:
                result["status"] = "fail"
    result["duration_ms"] = int((time.monotonic() - started) * 1000)
    vc.emit(result)


if __name__ == "__main__":
    try:
        main()
    except vc.InputError as exc:
        vc.emit({"schema": "verity.bench/1", "status": "input_error", "message": str(exc)}, vc.EXIT_INPUT)
    except Exception as exc:
        vc.emit({"schema": "verity.bench/1", "status": "internal_error", "message": str(exc)}, vc.EXIT_INTERNAL)
