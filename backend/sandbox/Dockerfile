# Verity tool image: verity-tools:0.2 (ARCHITECTURE 11.2, CONTRACTS section 3.1).
#
# One image, pinned tools, one entrypoint script per stage under /verity/bin (verify, measure, eqy, bundle).
# Build (from backend/): docker build -t verity-tools:0.2 --build-context bench=bench -f sandbox/Dockerfile sandbox
#
# Tool sources (all open source, see sandbox/README.md for the licence table):
#   Icarus Verilog 12.0, Verilator 5.x   Ubuntu 24.04 packages (the base tag pins the versions)
#   cocotb 1.9.2                         PyPI wheel into /opt/venv (binary wheel only, no compiler needed)
#   Yosys, EQY, SBY, yosys-smtbmc, SMT   YosysHQ OSS CAD Suite release 2026-10-05 (only its bin/ is put AFTER the
#                                        system PATH, so the Ubuntu iverilog and verilator are the ones used)
#   OpenSTA                              built from source at a pinned commit (needs CUDD, pinned below)
#   Nangate45 liberty                    downloaded at build time from OpenROAD-flow-scripts at a pinned commit,
#                                        never committed to this repo
#
# UNVERIFIED: nothing in this file has been built yet (no docker build in the first build pass). First build is
# expected to need small fixes; the most likely trouble spots are marked UNVERIFIED below.

# ---------------------------------------------------------------------------------------------
# Stage 1: build OpenSTA (and CUDD, which OpenSTA requires) from pinned sources.
# ---------------------------------------------------------------------------------------------
FROM ubuntu:24.04 AS sta-build
ARG DEBIAN_FRONTEND=noninteractive
# cuddorg/cudd tag cudd-3.0.0 (OpenSTA README: CUDD 3.0.0)
ARG CUDD_COMMIT=f54f533303640afd5dbe47a05ebeabb3066f2a25
# parallaxsw/OpenSTA master (CMake project version 3.1.0) on 2026-10-05
ARG OPENSTA_COMMIT=7a034b56de14b485ddf8fd97b420a6f37a91c00d

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates autoconf automake libtool pkg-config \
        tcl-dev tcl8.6-dev swig bison flex libfl-dev libeigen3-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# CUDD ships files generated by automake 1.14; a git clone resets timestamps so make tries to rerun aclocal-1.14.
# Always regenerate with the installed autotools.
RUN git clone https://github.com/cuddorg/cudd.git /src/cudd \
    && cd /src/cudd && git checkout "${CUDD_COMMIT}" \
    && autoreconf -fi \
    && ./configure --prefix=/opt/cudd \
    && make -j"$(nproc)" && make install

# UNVERIFIED: OpenSTA CMake build at this commit on Ubuntu 24.04 (gcc 13, tcl 8.6, swig 4.2, eigen 3.4).
RUN git clone https://github.com/parallaxsw/OpenSTA.git /src/OpenSTA \
    && cd /src/OpenSTA && git checkout "${OPENSTA_COMMIT}" \
    && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCUDD_DIR=/opt/cudd \
    && cmake --build build -j"$(nproc)" \
    && install -D build/sta /opt/opensta/bin/sta

# ---------------------------------------------------------------------------------------------
# Stage 2: checksum-verified RV32I toolchain and pinned benchmark sources.
# Supply the board directory with --build-context bench=bench (from backend/).
# ---------------------------------------------------------------------------------------------
FROM ubuntu:24.04 AS bench-build
ARG DEBIAN_FRONTEND=noninteractive
ARG XPACK_VERSION=14.2.0-3
ARG XPACK_SHA256=f574415b63f12b09bdd3475223ab492a465d23810646c90c13a4c3b676c83503
ARG EMBENCH_COMMIT=09c2ed8c3b7008c95d08b038de4a3f6dc103ed70
ARG RISCV_FORMAL_COMMIT=c992aa61fdfe0846c5ed90324c596202a1c69b76
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git python3 \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases/download/v${XPACK_VERSION}/xpack-riscv-none-elf-gcc-${XPACK_VERSION}-linux-x64.tar.gz" -o /tmp/gcc.tar.gz \
    && echo "${XPACK_SHA256}  /tmp/gcc.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/riscv-gcc && tar -xzf /tmp/gcc.tar.gz --strip-components=1 -C /opt/riscv-gcc \
    && rm /tmp/gcc.tar.gz
RUN git clone https://github.com/embench/embench-iot.git /opt/embench-iot \
    && git -C /opt/embench-iot checkout "${EMBENCH_COMMIT}" \
    && git clone https://github.com/YosysHQ/riscv-formal.git /opt/riscv-formal \
    && git -C /opt/riscv-formal checkout "${RISCV_FORMAL_COMMIT}" \
    && printf '%s\n' "${EMBENCH_COMMIT}" > /opt/embench-iot/VERITY_COMMIT \
    && printf '%s\n' "${RISCV_FORMAL_COMMIT}" > /opt/riscv-formal/VERITY_COMMIT \
    && rm -rf /opt/embench-iot/.git /opt/riscv-formal/.git
ENV PATH=/opt/riscv-gcc/bin:$PATH
COPY --from=bench crt0.S link.ld boardsupport.c build.py /src/board/
RUN python3 /src/board/build.py /opt/embench-iot /verity/bench

# ---------------------------------------------------------------------------------------------
# Stage 3: the runtime image.
# ---------------------------------------------------------------------------------------------
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
ARG OSS_CAD_TAG=2026-10-05
ARG OSS_CAD_FILE=oss-cad-suite-linux-x64-20261005.tgz
ARG COCOTB_VERSION=1.9.2
# OpenROAD-flow-scripts master on 2026-10-05; the path is the standard Nangate45 typical-corner liberty.
ARG NANGATE_COMMIT=6fc813e2b8d6c9fef68376d506c80283733e072f
ARG NANGATE_URL=https://raw.githubusercontent.com/The-OpenROAD-Project/OpenROAD-flow-scripts/${NANGATE_COMMIT}/flow/platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib
# Optional integrity pin. Leave empty on the first build; the build prints the hash to copy here.
ARG NANGATE_SHA256=""

# Runtime packages. libpython3.12-dev gives cocotb the shared libpython; libtcl8.6 and zlib1g are OpenSTA runtime
# libraries; bash and perl are needed by the OSS CAD Suite wrappers and by Verilator.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl bash perl make g++ \
        python3 python3-venv libpython3-dev \
        iverilog verilator \
        libtcl8.6 zlib1g libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && iverilog -V | head -1 | tee /dev/stderr | grep -q "version 12" \
    && verilator --version

# OSS CAD Suite: Yosys, EQY, SBY, yosys-smtbmc and the SMT solvers. Large tools the pipeline never uses are removed.
# UNVERIFIED: which paths are safe to delete; the removals below only touch place-and-route and viewer tools.
RUN curl -fsSL "https://github.com/YosysHQ/oss-cad-suite-build/releases/download/${OSS_CAD_TAG}/${OSS_CAD_FILE}" \
        -o /tmp/oss-cad-suite.tgz \
    && mkdir -p /opt && tar -xzf /tmp/oss-cad-suite.tgz -C /opt && rm /tmp/oss-cad-suite.tgz \
    && rm -rf /opt/oss-cad-suite/share/nextpnr /opt/oss-cad-suite/libexec/nextpnr* /opt/oss-cad-suite/bin/nextpnr* \
              /opt/oss-cad-suite/share/gtkwave /opt/oss-cad-suite/bin/gtkwave* /opt/oss-cad-suite/libexec/gtkwave* \
    && ls /opt/oss-cad-suite/bin | grep -E '^(yosys|eqy|sby|yosys-smtbmc|yosys-abc|yices-smt2|z3|boolector)$'

# OpenSTA binary from stage 1.
COPY --from=sta-build /opt/opensta/bin/sta /opt/opensta/bin/sta
COPY --from=bench-build /opt/riscv-gcc /opt/riscv-gcc
COPY --from=bench-build /opt/embench-iot /opt/embench-iot
COPY --from=bench-build /opt/riscv-formal /opt/riscv-formal
COPY --from=bench-build /verity/bench /verity/bench

# cocotb into its own venv (binary wheels only: no compiler in this image).
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --only-binary=:all: "cocotb==${COCOTB_VERSION}" \
    && /opt/venv/bin/cocotb-config --version

# Nangate45 liberty, downloaded here and never committed. The source URL and the hash are recorded next to it.
RUN mkdir -p /verity/pdk/nangate45 \
    && curl -fsSL "${NANGATE_URL}" -o /verity/pdk/nangate45/NangateOpenCellLibrary_typical.lib \
    && sha256sum /verity/pdk/nangate45/NangateOpenCellLibrary_typical.lib | tee /tmp/nangate.sha256 \
    && if [ -n "${NANGATE_SHA256}" ]; then echo "${NANGATE_SHA256}  /verity/pdk/nangate45/NangateOpenCellLibrary_typical.lib" | sha256sum -c -; fi \
    && { echo "source: ${NANGATE_URL}"; echo "sha256: $(cut -d' ' -f1 /tmp/nangate.sha256)"; } > /verity/pdk/nangate45/SOURCE.txt \
    && chmod -R a+rX /verity/pdk

ENV PATH=/opt/venv/bin:/opt/opensta/bin:/opt/riscv-gcc/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/oss-cad-suite/bin \
    PYTHONPATH=/verity/lib \
    PYTHONDONTWRITEBYTECODE=1 \
    VERITY_LIBERTY=/verity/pdk/nangate45/NangateOpenCellLibrary_typical.lib \
    VERITY_PACK_DIR=/pack \
    VERITY_WORK_DIR=/work \
    HOME=/tmp

# Stage scripts and helpers. LF line endings are enforced by backend/.gitattributes.
COPY bin/ /verity/bin/
COPY lib/ /verity/lib/
RUN chmod 0755 /verity/bin/* && chmod 0644 /verity/lib/*.py \
    && mkdir -p /work /pack \
    && chown 1000:1000 /work \
    && python3 -c "import sys; sys.path.insert(0, '/verity/lib'); import json, verity_common as vc; json.dump(vc.probe_versions(), open('/verity/versions.json', 'w'), indent=2)" \
    && cat /verity/versions.json

# Same uid as the local runner (docker run --user 1000:1000). The base image already has uid 1000 (ubuntu).
USER 1000:1000
WORKDIR /work
CMD ["/verity/bin/verify"]
